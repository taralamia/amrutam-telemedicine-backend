APP_ENV=development
APP_NAME=Amrutam Telemedicine API
REDIS_URL=
TRUSTED_HOSTS=*
TRUSTED_PROXY_HOPS=0
OTEL_SERVICE_NAME=amrutam-telemedicine-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
DATABASE_URL=postgresql+psycopg://amrutam:change-me@localhost:5432/amrutam
LOG_LEVEL=INFO
SEED_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=amrutam-api
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
DATA_ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_RATE_LIMIT_PER_MINUTE=10
BOOKING_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
